<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/MainMenu.uss?fileID=7433441132597879392&amp;guid=f037d40920088024c8918b1fecddac7f&amp;type=3#MainMenu" />
    <engine:VisualElement style="flex-grow: 1; justify-content: center; align-items: center;">
        <engine:VisualElement>
            <engine:Button text="Resume" name="ResumeButton" />
            <engine:Button text="Exit" name="ExitButton" />
        </engine:VisualElement>
        <engine:Label text="Game Paused" style="top: 20%; position: absolute; font-size: 72px; -unity-font-style: bold; color: rgb(255, 255, 255);" />
        <engine:Label text="[E] Interact&#10;[Tab] Switch Character" style="position: absolute; left: 50px; bottom: 50px; font-size: 40px; color: rgb(255, 255, 255); -unity-font-style: bold;" />
        <engine:Label text="Jump [Space]&#10;Move [W, A, S, D]" style="position: absolute; font-size: 40px; color: rgb(255, 255, 255); -unity-font-style: bold; right: 50px; bottom: 50px; -unity-text-align: upper-right;" />
    </engine:VisualElement>
</engine:UXML>
